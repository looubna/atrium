# Local development against the Firebase emulators and a local API
# (uvicorn on :8000, proxied at /api by the Vite dev server).
# demo-* projects never reach Google Cloud; the API key is a placeholder the emulators accept.
VITE_API_BASE_URL=
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-atrium
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-atrium.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
