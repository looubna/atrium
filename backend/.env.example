# Local development settings. Copy to backend/.env.local (git-ignored) and
# export before running: set -a; source .env.local; set +a
#
# Deployed environments receive these from Terraform (infra/terraform); never
# put production values in a local file.

# local | test | dev | staging | prod — each is locked to its own projects.
APP_ENV=local
# api | worker
ROLE=api

# Data project. Local development uses the Firebase emulators (demo-* projects never reach Google Cloud).
GOOGLE_CLOUD_PROJECT=demo-atrium
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
USER_CONTENT_BUCKET=demo-atrium-user-content
PROCESSING_BUCKET=demo-atrium-processing

# AI: "fake" runs deterministic stand-ins with no Google Cloud calls.
# "vertex" bills the dev project (the only AI project allowed for APP_ENV=local).
AI_PROVIDER=fake
VERTEX_PROJECT=atrium-coach-dev
GOOGLE_GENAI_USE_VERTEXAI=TRUE
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_LOCATION=us-central1
TEXT_MODEL=gemini-3.8-flash
TEXT_LOCATION=global
SPEECH_LOCATION=us

# App Check is enforced in staging/prod; locally the app uses the debug provider.
APP_CHECK_ENFORCED=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost

# Async processing (Cloud Tasks targets the worker with OIDC tokens).
TASKS_LOCATION=us-central1
TASKS_INVOKER_SA=
WORKER_URL=http://127.0.0.1:8081

# In-person faces (infra/livetalking). LIVETALKING_AVATAR: one test recording for every face.
LIVETALKING_URL=
# Or the GPU VMs to start on demand, in failover order (zone/name,...); overrides LIVETALKING_URL.
FACE_VMS=
LIVETALKING_SECRET=
LIVETALKING_AVATAR=
# Who each recorded face plays, e.g. william=william,gabriel=william (others get LIVETALKING_AVATAR).
LIVETALKING_FACES=

# Limits
FREE_TRIAL_MINUTES=20
RECORDING_RETENTION_DAYS=365
LOG_LEVEL=INFO

# Required in dev/staging/prod (Secret Manager); optional locally.
ANALYTICS_SALT=
